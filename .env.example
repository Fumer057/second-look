# --- Option A: hosted Gemma via Google AI Studio (free key: https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-google-ai-studio-key
# Comma-separated fallbacks: the first model that responds wins
LLM_MODEL=gemma-4-26b-a4b-it,gemma-4-31b-it

# --- Option B: fully local, nothing leaves your laptop (install Ollama, then `ollama pull gemma3:4b`)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=gemma3:4b

REGION=India

# Optional: MongoDB Atlas for an anonymized "recent checks" family view (verdicts only, never messages)
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net

# Optional: WhatsApp Bot via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_JOIN_CODE=join happy-tiger
# PUBLIC_URL=https://your-app.onrender.com
